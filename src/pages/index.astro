---
import "../styles/global.css";

const instagramUrl = "https://www.instagram.com/elenamuzyka.photography";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Elena Muzyka Photography. A new photography portfolio, launching soon."
    />
    <title>Elena Muzyka Photography</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="hero" aria-labelledby="site-title">
        <header class="site-header">
          <a class="brand" href="/" aria-label="Elena Muzyka Photography home">
            <img
              src="/images/instagram-profile.jpg"
              alt=""
              width="100"
              height="100"
            />
            <span>Elena Muzyka</span>
          </a>
          <a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @elenamuzyka.photography
          </a>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Photography portfolio</p>
            <h1 id="site-title">Elena Muzyka Photography</h1>
            <p class="intro">
              A new photography business taking shape. The full portfolio is coming
              soon; for now, follow Elena's latest work on Instagram.
            </p>
            <div class="actions">
              <a class="button primary" href={instagramUrl} target="_blank" rel="noreferrer">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                View Instagram
              </a>
            </div>
          </div>

          <div class="image-panel" aria-label="Selected photography areas">
            <div class="photo-tile tall">
              <span>Portraits</span>
            </div>
            <div class="photo-tile warm">
              <span>Families</span>
            </div>
            <div class="photo-tile cool">
              <span>Stories</span>
            </div>
          </div>
        </div>
      </section>

      <section class="status" aria-label="Website status">
        <p>Portfolio, session details, and booking information will be added here as the business grows.</p>
      </section>
    </main>
  </body>
</html>
