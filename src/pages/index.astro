          footerAvailability: "Доступна для портретних і комерційних сесій.",
          footerLocation: "Попрад, Словаччина",
        },
        en: {
          eyebrow: "Photography in Poprad, Slovakia",
          intro:
            "Portrait, fine art, and commercial photography with a soft cinematic touch. For people and brands who want to feel natural, seen, and quietly elevated.",
