---
import { Image } from "astro:assets";
import "../styles/global.css";

const instagramUrl = "https://www.instagram.com/elenamuzyka.photography";

const portfolioSections = [
  {
    titleKey: "portraitTitle",
    images: [
      {
        src: "/images/portfolio/portraits/portrait-01.jpg",
        alt: "Close-up portrait of a woman resting her chin on her hand",
        className: "tall",
        width: 2178,
        height: 3267,
      },
    ],
  },
  {
    titleKey: "fineArtTitle",
    images: [
      {
        src: "/images/portfolio/fine-art/fine-art-01.jpg",
        alt: "Layered fine art portrait with city textures and red hair",
        className: "wide",
        width: 2048,
        height: 1638,
      },
    ],
  },
  {
    titleKey: "commercialTitle",
    projects: [
      {
        titleKey: "vereskTitle",
        descriptionKey: "vereskDescription",
        images: [
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-01.jpg",
            alt: "Three models wearing Veresk Clothes robes",
            className: "wide",
            width: 4160,
            height: 2773,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-02.jpg",
            alt: "Three seated models wearing Veresk Clothes robes",
            className: "tall",
            width: 2773,
            height: 4160,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-03.jpg",
            alt: "Three models in Veresk Clothes robes facing camera",
            className: "wide",
            width: 4160,
            height: 2773,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-04.jpg",
            alt: "Three models standing in neutral Veresk Clothes robes",
            className: "tall",
            width: 2773,
            height: 4160,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-05.jpg",
            alt: "Red-haired model seated in a light Veresk Clothes robe",
            className: "portrait",
            width: 2774,
            height: 4160,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-06.jpg",
            alt: "Red-haired model leaning forward in a light Veresk Clothes robe",
            className: "portrait",
            width: 2773,
            height: 4160,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-07.jpg",
            alt: "Three models reading in Veresk Clothes robes",
            className: "wide",
            width: 4160,
            height: 2773,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-08.jpg",
            alt: "Three models by studio windows in Veresk Clothes robes",
            className: "wide",
            width: 4160,
            height: 2773,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-09.jpg",
            alt: "Three models reading by tall windows in Veresk Clothes robes",
            className: "tall",
            width: 2773,
            height: 4160,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-10.jpg",
            alt: "Model applying makeup in a Veresk Clothes robe",
            className: "portrait",
            width: 2773,
            height: 4160,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-11.jpg",
            alt: "Two models styling hair in Veresk Clothes robes",
            className: "portrait",
            width: 2773,
            height: 4160,
          },
        ],
      },
    ],
  },
];

const featuredSections = portfolioSections.filter((section) => section.images);
const projectSections = portfolioSections.filter((section) => section.projects);

const defaultCopy = {
  portraitTitle: "Портрет",
  fineArtTitle: "Художня фотографія",
  commercialTitle: "Комерційна фотографія",
  vereskTitle: "Veresk Clothes",
  vereskDescription: "Окремий комерційний проєкт для @veresk.clothes.",
};
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Elena Muzyka Photography. A new photography portfolio from Poprad, Slovakia, launching soon."
    />
    <title>Elena Muzyka Photography</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="hero" aria-labelledby="site-title">
        <header class="site-header">
          <a class="brand" href="/" aria-label="Elena Muzyka Photography home">
            <img
              src="/images/instagram-profile.jpg"
              alt=""
              width="100"
              height="100"
            />
            <span>Elena Muzyka</span>
          </a>
          <a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @elenamuzyka.photography
          </a>
          <div class="language-switch" aria-label="Language">
            <button
              type="button"
              class="active"
              data-language-button="uk"
              aria-label="Ukrainian"
              title="Ukrainian"
            >
              <span aria-hidden="true">🇺🇦</span>
            </button>
            <button
              type="button"
              data-language-button="sk"
              aria-label="Slovak"
              title="Slovak"
            >
              <span aria-hidden="true">🇸🇰</span>
            </button>
            <button
              type="button"
              data-language-button="en"
              aria-label="English"
              title="English"
            >
              <span aria-hidden="true">🇬🇧</span>
            </button>
          </div>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span data-i18n="eyebrow">Фотографія в Попраді, Словаччина</span>
            </p>
            <h1 id="site-title">Elena Muzyka Photography</h1>
            <p class="intro">
              <span data-i18n="intro">
                Нове фотографічне портфоліо від Elena Muzyka. Повна галерея вже
                незабаром; поки що стежте за новими роботами Elena
                в Instagram.
              </span>
            </p>
            <div class="actions">
              <a class="button primary" href={instagramUrl} target="_blank" rel="noreferrer">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span data-i18n="instagramButton">Переглянути Instagram</span>
              </a>
            </div>
          </div>

          <div class="image-panel">
            <Image
              src="/images/featured-photo.jpg"
              alt="Elena Muzyka Photography preview"
              width="1080"
              height="1080"
              loading="eager"
              decoding="async"
            />
            <p>
              <span data-i18n="photoCaption">
                Нові роботи та закулісні моменти з'являються в Instagram.
              </span>
            </p>
          </div>
        </div>
      </section>

      <section class="portfolio-preview" aria-label="Portfolio">
          <div class="portfolio-feature-categories">
            {
              featuredSections.map((section) => (
                <section class="portfolio-category">
                  <header class="portfolio-category-header">
                    <h2 data-i18n={section.titleKey}>{defaultCopy[section.titleKey]}</h2>
                  </header>

                  <div class="portfolio-grid compact">
                    {section.images.map((image) => (
                      <figure class={image.className}>
                        <button
                          type="button"
                          class="portfolio-trigger"
                          data-lightbox-src={image.src}
                          data-lightbox-alt={image.alt}
                        >
                          <Image
                            src={image.src}
                            alt={image.alt}
                            width={image.width}
                            height={image.height}
                            loading="lazy"
                            decoding="async"
                          />
                        </button>
                      </figure>
                    ))}
                  </div>
                </section>
              ))
            }
          </div>

          {
            projectSections.map((section) => (
              <section class="portfolio-category">
                <header class="portfolio-category-header">
                  <h2 data-i18n={section.titleKey}>{defaultCopy[section.titleKey]}</h2>
                </header>

                {section.projects?.map((project) => (
                  <section class="portfolio-project">
                    <header class="portfolio-project-header">
                      <h3 data-i18n={project.titleKey}>{defaultCopy[project.titleKey]}</h3>
                      <p data-i18n={project.descriptionKey}>
                        {defaultCopy[project.descriptionKey]}
                      </p>
                    </header>
                    <div class="portfolio-grid">
                      {project.images.map((image) => (
                        <figure class={image.className}>
                          <button
                            type="button"
                            class="portfolio-trigger"
                            data-lightbox-src={image.src}
                            data-lightbox-alt={image.alt}
                          >
                            <Image
                              src={image.src}
                              alt={image.alt}
                              width={image.width}
                              height={image.height}
                              loading="lazy"
                              decoding="async"
                            />
                          </button>
                        </figure>
                      ))}
                    </div>
                  </section>
                ))}
              </section>
            ))
          }
      </section>
    </main>

    <dialog class="lightbox" aria-label="Portfolio image preview">
      <img src="" alt="" />
    </dialog>

    <script>
      const copy = {
        uk: {
          eyebrow: "Фотографія в Попраді, Словаччина",
          intro:
            "Нове фотографічне портфоліо від Elena Muzyka. Повна галерея вже незабаром; поки що стежте за новими роботами Elena в Instagram.",
          instagramButton: "Переглянути Instagram",
          photoCaption: "Нові роботи та закулісні моменти з'являються в Instagram.",
          portraitTitle: "Портрет",
          fineArtTitle: "Художня фотографія",
          commercialTitle: "Комерційна фотографія",
          vereskTitle: "Veresk Clothes",
          vereskDescription: "Окремий комерційний проєкт для @veresk.clothes.",
        },
        en: {
          eyebrow: "Photography in Poprad, Slovakia",
          intro:
            "A new photography portfolio from Elena Muzyka. The full gallery is coming soon; for now, follow Elena's latest work on Instagram.",
          instagramButton: "View Instagram",
          photoCaption: "New work and behind-the-scenes previews are shared on Instagram.",
          portraitTitle: "Portrait",
          fineArtTitle: "Fine Art",
          commercialTitle: "Commercial",
          vereskTitle: "Veresk Clothes",
          vereskDescription: "A standalone commercial project for @veresk.clothes.",
        },
        sk: {
          eyebrow: "Fotografka v Poprade, Slovensko",
          intro:
            "Nové fotografické portfólio od Elena Muzyka. Kompletnú galériu pripravujeme; zatiaľ sledujte najnovšiu tvorbu Elena na Instagrame.",
          instagramButton: "Zobraziť Instagram",
          photoCaption: "Novú tvorbu a zákulisné momenty nájdete na Instagrame.",
          portraitTitle: "Portrét",
          fineArtTitle: "Umelecká fotografia",
          commercialTitle: "Komerčná fotografia",
          vereskTitle: "Veresk Clothes",
          vereskDescription: "Samostatný komerčný projekt pre @veresk.clothes.",
        },
      };

      const setLanguage = (language) => {
        document.documentElement.lang = language;
        document.querySelectorAll("[data-i18n]").forEach((element) => {
          const key = element.getAttribute("data-i18n");
          element.textContent = copy[language][key];
        });
        document.querySelectorAll("[data-language-button]").forEach((button) => {
          button.classList.toggle(
            "active",
            button.getAttribute("data-language-button") === language,
          );
        });
      };

      document.querySelectorAll("[data-language-button]").forEach((button) => {
        button.addEventListener("click", () => {
          setLanguage(button.getAttribute("data-language-button"));
        });
      });

      const lightbox = document.querySelector(".lightbox");
      const lightboxImage = lightbox.querySelector("img");
      const closeLightbox = () => {
        lightbox.close();
        lightboxImage.removeAttribute("src");
        lightboxImage.alt = "";
      };

      document.querySelectorAll("[data-lightbox-src]").forEach((button) => {
        button.addEventListener("click", () => {
          lightboxImage.src = button.getAttribute("data-lightbox-src");
          lightboxImage.alt = button.getAttribute("data-lightbox-alt");
          lightbox.showModal();
        });
      });

      lightboxImage.addEventListener("click", closeLightbox);
      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      lightbox.addEventListener("cancel", () => {
        lightboxImage.removeAttribute("src");
        lightboxImage.alt = "";
      });
    </script>
  </body>
</html>
