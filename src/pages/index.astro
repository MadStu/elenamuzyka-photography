          projectClientLabel: "Client",
          projectClientValue: "Veresk Clothes",
          projectTypeLabel: "Type",
          projectTypeValue: "Brand story",
          projectMoodLabel: "Mood",
          projectMoodValue: "Soft, natural, intimate",
          experienceLabel: "The session",
          experienceTitle:
            "A calm space, gentle direction, and photographs that still feel like you.",
          experienceText:
            "Elena works with care and quiet attention: helping people relax, noticing natural gestures, and creating portraits and brand stories that feel personal.",
