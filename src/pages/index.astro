          vereskTitle: "Veresk Clothes",
          vereskDescription:
            "Mäkký príbeh v prirodzenom svetle pre @veresk.clothes, postavený na pokojných gestách, textúre a blízkej editoriálovej atmosfére.",
          approachLabel: "Prístup",
          approachTitle: "Pokojné portréty, pozorné príbehy a mäkké prirodzené svetlo.",
          approachText:
            "Elena tvorí portrétnu, umeleckú a komerčnú fotografiu v Poprade. V jej práci je dôležitý charakter, atmosféra a detaily, vďaka ktorým obraz pôsobí živo.",
          detailLocationLabel: "Miesto",
          detailLocationValue: "Poprad, Slovensko",
          detailFocusLabel: "Zameranie",
          detailFocusValue: "Portréty, fine art, značky",
          detailLanguageLabel: "Jazyky",
          detailLanguageValue: "Ukrajinčina, slovenčina, angličtina",
          portfolioLabel: "Portfólio",
          projectMeta: "Komerčný projekt",
          projectClientLabel: "Klient",
          projectClientValue: "Veresk Clothes",
          projectTypeLabel: "Typ",
          projectTypeValue: "Príbeh značky",
          projectMoodLabel: "Nálada",
          projectMoodValue: "Mäkká, prirodzená, blízka",
          experienceLabel: "Fotenie",
          experienceTitle:
            "Pokojný priestor, jemné vedenie a fotografie, v ktorých spoznáte seba.",
          experienceText:
            "Elena pracuje citlivo a pozorne: pomáha ľuďom uvoľniť sa, všíma si prirodzené gestá a tvorí portréty aj príbehy značiek, ktoré pôsobia osobne.",
          bookingText:
            "Dostupná pre portrétne, fine art a komerčné fotenia v Poprade aj podľa dohody.",
          bookingButton: "Opýtať sa na fotenie",
          footerAvailability: "Dostupná pre portrétne a komerčné fotenia.",
          footerLocation: "Poprad, Slovensko",
        },
      };

      document.body.classList.add("motion-ready");

      const themeToggle = document.querySelector("[data-theme-toggle]");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");

      const getActiveTheme = () => {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") return storedTheme;
        return systemTheme.matches ? "dark" : "light";
      };

      const syncThemeToggle = () => {
        const theme = getActiveTheme();
        themeToggle.setAttribute("aria-pressed", theme === "dark");
        themeToggle.setAttribute(
          "aria-label",
          theme === "dark" ? "Use light theme" : "Use dark theme",
        );
      };

      themeToggle.addEventListener("click", () => {
        const nextTheme = getActiveTheme() === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);
        syncThemeToggle();
      });

      systemTheme.addEventListener("change", () => {
        if (!localStorage.getItem("theme")) syncThemeToggle();
      });

      syncThemeToggle();

      const setLanguage = (language) => {
        document.documentElement.lang = language;
        document.querySelectorAll("[data-i18n]").forEach((element) => {
          const key = element.getAttribute("data-i18n");
          element.textContent = copy[language][key];
        });
        document.querySelectorAll("[data-language-button]").forEach((button) => {
          const isActive = button.getAttribute("data-language-button") === language;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", isActive);
        });
      };

      document.querySelectorAll("[data-language-button]").forEach((button) => {
        button.addEventListener("click", () => {
          setLanguage(button.getAttribute("data-language-button"));
        });
      });

      const lightbox = document.querySelector(".lightbox");
      const lightboxImage = lightbox.querySelector("img");
      const lightboxCount = lightbox.querySelector(".lightbox-count");
      const previousButton = lightbox.querySelector("[data-lightbox-previous]");
      const nextButton = lightbox.querySelector("[data-lightbox-next]");
      const lightboxItems = Array.from(document.querySelectorAll("[data-lightbox-src]")).map(
        (button) => ({
          button,
          src: button.getAttribute("data-lightbox-src"),
          alt: button.getAttribute("data-lightbox-alt"),
        }),
      );
      let currentLightboxIndex = 0;

      const showLightboxImage = (index) => {
        currentLightboxIndex = (index + lightboxItems.length) % lightboxItems.length;
        const item = lightboxItems[currentLightboxIndex];
        lightboxImage.src = item.src;
        lightboxImage.alt = item.alt;
        lightboxCount.textContent = `${currentLightboxIndex + 1} / ${lightboxItems.length}`;
      };

      const closeLightbox = () => {
        lightbox.close();
        lightboxImage.removeAttribute("src");
        lightboxImage.alt = "";
        lightboxCount.textContent = "";
      };

      lightboxItems.forEach((item, index) => {
        item.button.addEventListener("click", () => {
          showLightboxImage(index);
          lightbox.showModal();
        });
      });

      previousButton.addEventListener("click", (event) => {
        event.stopPropagation();
        showLightboxImage(currentLightboxIndex - 1);
      });

      nextButton.addEventListener("click", (event) => {
        event.stopPropagation();
        showLightboxImage(currentLightboxIndex + 1);
      });

      lightboxImage.addEventListener("click", closeLightbox);
      lightbox.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      lightbox.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") showLightboxImage(currentLightboxIndex - 1);
        if (event.key === "ArrowRight") showLightboxImage(currentLightboxIndex + 1);
      });
      lightbox.addEventListener("cancel", () => {
        lightboxImage.removeAttribute("src");
        lightboxImage.alt = "";
        lightboxCount.textContent = "";
      });

      const revealTargets = document.querySelectorAll(".reveal");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.16 },
      );

      revealTargets.forEach((target) => revealObserver.observe(target));
    </script>
  </body>
</html>
