---
import { Image } from "astro:assets";
import "../styles/global.css";

const instagramUrl = "https://www.instagram.com/elenamuzyka.photography";
const siteUrl = "https://elenamuzyka.photography";
const siteDescription =
  "Portrait, fine art, and commercial photography by Elena Muzyka in Poprad, Slovakia.";

const portfolioSections = [
  {
    titleKey: "portraitTitle",
    images: [
      {
        src: "/images/portfolio/portraits/portrait-01.jpg",
        alt: "Close-up portrait of a woman resting her chin on her hand",
        className: "tall",
        width: 1466,
        height: 2200,
      },
    ],
  },
  {
    titleKey: "fineArtTitle",
    images: [
      {
        src: "/images/portfolio/fine-art/fine-art-01.jpg",
        alt: "Layered fine art portrait with city textures and red hair",
        className: "wide",
        width: 2048,
        height: 1638,
      },
    ],
  },
  {
    titleKey: "commercialTitle",
    projects: [
      {
        titleKey: "vereskTitle",
        descriptionKey: "vereskDescription",
        detailKeys: [
          ["projectClientLabel", "projectClientValue"],
          ["projectTypeLabel", "projectTypeValue"],
          ["projectMoodLabel", "projectMoodValue"],
        ],
        images: [
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-08.jpg",
            alt: "Three models by studio windows in Veresk Clothes robes",
            className: "wide feature",
            width: 2200,
            height: 1466,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-01.jpg",
            alt: "Three models wearing Veresk Clothes robes",
            className: "wide",
            width: 2200,
            height: 1466,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-03.jpg",
            alt: "Three models in Veresk Clothes robes facing camera",
            className: "wide",
            width: 2200,
            height: 1466,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-10.jpg",
            alt: "Model applying makeup in a Veresk Clothes robe",
            className: "portrait",
            width: 1466,
            height: 2200,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-11.jpg",
            alt: "Two models styling hair in Veresk Clothes robes",
            className: "portrait",
            width: 1466,
            height: 2200,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-07.jpg",
            alt: "Three models reading in Veresk Clothes robes",
            className: "wide",
            width: 2200,
            height: 1466,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-04.jpg",
            alt: "Three models standing in neutral Veresk Clothes robes",
            className: "tall",
            width: 1466,
            height: 2200,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-05.jpg",
            alt: "Red-haired model seated in a light Veresk Clothes robe",
            className: "portrait",
            width: 1467,
            height: 2200,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-06.jpg",
            alt: "Red-haired model leaning forward in a light Veresk Clothes robe",
            className: "portrait",
            width: 1466,
            height: 2200,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-09.jpg",
            alt: "Three models reading by tall windows in Veresk Clothes robes",
            className: "tall",
            width: 1466,
            height: 2200,
          },
          {
            src: "/images/portfolio/commercial/veresk-clothes/veresk-clothes-02.jpg",
            alt: "Three seated models wearing Veresk Clothes robes",
            className: "tall",
            width: 1466,
            height: 2200,
          },
        ],
      },
    ],
  },
];

const featuredSections = portfolioSections.filter((section) => section.images);
const projectSections = portfolioSections.filter((section) => section.projects);

const defaultCopy = {
  portraitTitle: "Портрет",
  fineArtTitle: "Художня фотографія",
  commercialTitle: "Комерційна фотографія",
  vereskTitle: "Veresk Clothes",
  vereskDescription:
    "М’яка історія для бренду одягу @veresk.clothes: природне світло, спокійні жести та відчуття близькості.",
  approachLabel: "Підхід",
  approachTitle: "Тихі портрети, уважні історії та м’яке природне світло.",
  approachText:
    "Elena створює портретну, художню та комерційну фотографію в Попраді. Її роботи зосереджені на характері, атмосфері та деталях, які роблять образ живим.",
  detailLocationLabel: "Локація",
  detailLocationValue: "Попрад, Словаччина",
  detailFocusLabel: "Фокус",
  detailFocusValue: "Портрети, fine art, бренди",
  detailLanguageLabel: "Мови",
  detailLanguageValue: "Українська, Slovensky, English",
  portfolioLabel: "Портфоліо",
  projectMeta: "Комерційний проєкт",
  projectClientLabel: "Клієнт",
  projectClientValue: "Veresk Clothes",
  projectTypeLabel: "Тип",
  projectTypeValue: "Бренд-історія",
  projectMoodLabel: "Настрій",
  projectMoodValue: "М’яко, природно, близько",
  experienceLabel: "Фотосесія",
  experienceTitle: "Спокійний простір, м’яке ведення та фотографії, у яких ви впізнаєте себе.",
  experienceText:
    "Elena працює уважно й делікатно: допомагає розслабитися, помічає природні жести та створює портрети й бренд-історії, які відчуваються особистими.",
  bookingText: "Доступна для портретних, fine art та комерційних зйомок у Попраді й за домовленістю.",
  bookingButton: "Запитати про зйомку",
  footerAvailability: "Доступна для портретних і комерційних сесій.",
  footerLocation: "Попрад, Словаччина",
};
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={siteDescription}
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content="Elena Muzyka Photography" />
    <meta property="og:description" content={siteDescription} />
    <meta
      property="og:image"
      content={`${siteUrl}/images/hero/elena-camera-self-portrait.jpg`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Elena Muzyka Photography" />
    <meta name="twitter:description" content={siteDescription} />
    <meta
      name="twitter:image"
      content={`${siteUrl}/images/hero/elena-camera-self-portrait.jpg`}
    />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Elena Muzyka Photography</title>
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      if (storedTheme === "light" || storedTheme === "dark") {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
  </head>
  <body>
    <main class="page-shell">
      <section class="hero" aria-labelledby="site-title">
        <header class="site-header">
          <a class="brand" href="/" aria-label="Elena Muzyka Photography home">
            <img
              src="/images/instagram-profile.jpg"
              alt=""
              width="100"
              height="100"
            />
            <span>Elena Muzyka</span>
          </a>
          <a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @elenamuzyka.photography
          </a>
          <div class="header-controls">
            <button
              type="button"
              class="theme-toggle"
              data-theme-toggle
              aria-label="Use dark theme"
              aria-pressed="false"
              title="Switch theme"
            >
              <span class="theme-icon sun" aria-hidden="true">☀</span>
              <span class="theme-icon moon" aria-hidden="true">☾</span>
            </button>
            <div class="language-switch" aria-label="Language">
              <button
                type="button"
                class="active"
                data-language-button="uk"
                aria-label="Ukrainian"
                aria-pressed="true"
                title="Ukrainian"
              >
                <span aria-hidden="true">🇺🇦</span>
              </button>
              <button
                type="button"
                data-language-button="sk"
                aria-label="Slovak"
                aria-pressed="false"
                title="Slovak"
              >
                <span aria-hidden="true">🇸🇰</span>
              </button>
              <button
                type="button"
                data-language-button="en"
                aria-label="English"
                aria-pressed="false"
                title="English"
              >
                <span aria-hidden="true">🇬🇧</span>
              </button>
            </div>
          </div>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span data-i18n="eyebrow">Фотографія в Попраді, Словаччина</span>
            </p>
            <h1 id="site-title">Elena Muzyka Photography</h1>
            <p class="intro">
              <span data-i18n="intro">
                Портретна, художня та комерційна фотографія з м’яким
                кінематографічним відчуттям. Для людей і брендів, які хочуть
                виглядати природно, уважно й по-справжньому.
              </span>
            </p>
            <div class="actions">
              <a class="button primary" href={instagramUrl} target="_blank" rel="noreferrer">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span data-i18n="instagramButton">Переглянути Instagram</span>
              </a>
            </div>

            <dl class="hero-details">
              <div>
                <dt data-i18n="detailLocationLabel">{defaultCopy.detailLocationLabel}</dt>
                <dd data-i18n="detailLocationValue">{defaultCopy.detailLocationValue}</dd>
              </div>
              <div>
                <dt data-i18n="detailFocusLabel">{defaultCopy.detailFocusLabel}</dt>
                <dd data-i18n="detailFocusValue">{defaultCopy.detailFocusValue}</dd>
              </div>
              <div>
                <dt data-i18n="detailLanguageLabel">{defaultCopy.detailLanguageLabel}</dt>
                <dd data-i18n="detailLanguageValue">{defaultCopy.detailLanguageValue}</dd>
              </div>
            </dl>
          </div>

          <div class="image-panel">
            <Image
              class="hero-image"
              src="/images/hero/elena-camera-self-portrait.jpg"
              alt="Elena holding a Canon camera in a warm self-portrait"
              width="671"
              height="1024"
              loading="eager"
              decoding="async"
            />
            <p>
              <span data-i18n="photoCaption">
                Нові роботи та закулісні моменти з'являються в Instagram.
              </span>
            </p>
          </div>
        </div>
      </section>

      <section class="approach-section reveal" aria-labelledby="approach-title">
        <p class="section-label" data-i18n="approachLabel">{defaultCopy.approachLabel}</p>
        <div class="approach-content">
          <Image
            class="approach-image"
            src="/images/approach/studio-approach.jpg"
            alt="Elena leaning her head against a mirror in a quiet, reflective portrait"
            width="581"
            height="576"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h2 id="approach-title" data-i18n="approachTitle">{defaultCopy.approachTitle}</h2>
            <p data-i18n="approachText">{defaultCopy.approachText}</p>
          </div>
        </div>
      </section>

      <section class="portfolio-preview" aria-label="Portfolio">
          <p class="portfolio-label section-label reveal" data-i18n="portfolioLabel">
            {defaultCopy.portfolioLabel}
          </p>

          <div class="portfolio-feature-categories">
            {
              featuredSections.map((section) => (
                <section class="portfolio-category reveal">
                  <header class="portfolio-category-header">
                    <h2 data-i18n={section.titleKey}>{defaultCopy[section.titleKey]}</h2>
                  </header>

                  <div class="portfolio-grid compact">
                    {section.images.map((image) => (
                      <figure class={image.className}>
                        <button
                          type="button"
                          class="portfolio-trigger"
                          data-lightbox-src={image.src}
                          data-lightbox-alt={image.alt}
                          aria-label={`Open ${image.alt}`}
                        >
                          <Image
                            src={image.src}
                            alt={image.alt}
                            width={image.width}
                            height={image.height}
                            loading="lazy"
                            decoding="async"
                            sizes="(max-width: 820px) 100vw, 50vw"
                          />
                        </button>
                      </figure>
                    ))}
                  </div>
                </section>
              ))
            }
          </div>

          {
            projectSections.map((section) => (
              <section class="portfolio-category reveal">
                <header class="portfolio-category-header">
                  <h2 data-i18n={section.titleKey}>{defaultCopy[section.titleKey]}</h2>
                </header>

                {section.projects?.map((project) => (
                  <section class="portfolio-project">
                    <header class="portfolio-project-header">
                      <div>
                        <p class="project-meta" data-i18n="projectMeta">
                          {defaultCopy.projectMeta}
                        </p>
                        <h3 data-i18n={project.titleKey}>{defaultCopy[project.titleKey]}</h3>
                        <dl class="project-details">
                          {project.detailKeys?.map(([labelKey, valueKey]) => (
                            <div>
                              <dt data-i18n={labelKey}>{defaultCopy[labelKey]}</dt>
                              <dd data-i18n={valueKey}>{defaultCopy[valueKey]}</dd>
                            </div>
                          ))}
                        </dl>
                      </div>
                      <p data-i18n={project.descriptionKey}>
                        {defaultCopy[project.descriptionKey]}
                      </p>
                    </header>
                    <div class="portfolio-grid">
                      {project.images.map((image) => (
                        <figure class={image.className}>
                          <button
                            type="button"
                            class="portfolio-trigger"
                            data-lightbox-src={image.src}
                            data-lightbox-alt={image.alt}
                            aria-label={`Open ${image.alt}`}
                          >
                            <Image
                              src={image.src}
                              alt={image.alt}
                              width={image.width}
                              height={image.height}
                              loading="lazy"
                              decoding="async"
                              sizes="(max-width: 820px) 100vw, 33vw"
                            />
                          </button>
                        </figure>
                      ))}
                    </div>
                  </section>
                ))}
              </section>
            ))
          }
      </section>

      <section class="booking-section reveal" aria-labelledby="booking-title">
        <p class="section-label" data-i18n="experienceLabel">{defaultCopy.experienceLabel}</p>
        <div class="booking-content">
          <h2 id="booking-title" data-i18n="experienceTitle">
            {defaultCopy.experienceTitle}
          </h2>
          <div class="booking-copy">
            <p data-i18n="experienceText">{defaultCopy.experienceText}</p>
            <p data-i18n="bookingText">{defaultCopy.bookingText}</p>
            <a class="button primary" href={instagramUrl} target="_blank" rel="noreferrer">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="18"
                height="18"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
              </svg>
              <span data-i18n="bookingButton">{defaultCopy.bookingButton}</span>
            </a>
          </div>
        </div>
      </section>

      <footer class="site-footer">
        <div>
          <p>Elena Muzyka Photography</p>
          <span data-i18n="footerAvailability">{defaultCopy.footerAvailability}</span>
        </div>
        <div>
          <span data-i18n="footerLocation">{defaultCopy.footerLocation}</span>
          <a href={instagramUrl} target="_blank" rel="noreferrer">@elenamuzyka.photography</a>
        </div>
      </footer>
    </main>

    <dialog class="lightbox" aria-label="Portfolio image preview">
      <div class="lightbox-controls" aria-label="Image navigation">
        <button type="button" class="lightbox-nav previous" data-lightbox-previous aria-label="Previous image">
          <span aria-hidden="true">‹</span>
        </button>
        <p class="lightbox-count" aria-live="polite"></p>
        <button type="button" class="lightbox-nav next" data-lightbox-next aria-label="Next image">
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <img src="" alt="" />
    </dialog>

    <script>
      const copy = {
        uk: {
          eyebrow: "Фотографія в Попраді, Словаччина",
          intro:
            "Портретна, художня та комерційна фотографія з м’яким кінематографічним відчуттям. Для людей і брендів, які хочуть виглядати природно, уважно й по-справжньому.",
          instagramButton: "Переглянути Instagram",
