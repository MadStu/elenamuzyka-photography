---
import "../styles/global.css";

const instagramUrl = "https://www.instagram.com/elenamuzyka.photography";

const categories = [
  ["Portrait / Individual", "Portrét / Individuálne fotenie"],
  ["Love Story", "Love Story"],
  ["Family", "Rodinné fotenie"],
  ["Wedding", "Svadobné fotenie"],
  ["Commercial / Brand", "Komerčné / Brand fotenie"],
  ["Fine Art", "Fine Art"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Elena Muzyka Photography. A new photography portfolio, launching soon."
    />
    <title>Elena Muzyka Photography</title>
  </head>
  <body>
    <main class="page-shell">
      <section class="hero" aria-labelledby="site-title">
        <header class="site-header">
          <a class="brand" href="/" aria-label="Elena Muzyka Photography home">
            <img
              src="/images/instagram-profile.jpg"
              alt=""
              width="100"
              height="100"
            />
            <span>Elena Muzyka</span>
          </a>
          <a class="social-link" href={instagramUrl} target="_blank" rel="noreferrer">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @elenamuzyka.photography
          </a>
          <div class="language-switch" aria-label="Language">
            <button type="button" class="active" data-language-button="en">EN</button>
            <button type="button" data-language-button="sk">SK</button>
          </div>
        </header>

        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              <span data-i18n="eyebrow">Photography in Poprad, Slovakia</span>
            </p>
            <h1 id="site-title">Elena Muzyka Photography</h1>
            <p class="intro">
              <span data-i18n="intro">
                Portrait, family, brand, and fine art photography from Poprad.
                The full portfolio is coming soon; for now, follow Elena's latest
                work on Instagram.
              </span>
            </p>
            <div class="actions">
              <a class="button primary" href={instagramUrl} target="_blank" rel="noreferrer">
                <svg
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                <span data-i18n="instagramButton">View Instagram</span>
              </a>
            </div>
          </div>

          <div class="image-panel">
            <img
              src="/images/featured-photo.jpg"
              alt="Selected work by Elena Muzyka Photography"
              width="1080"
              height="1080"
            />
            <p>
              <span data-i18n="photoCaption">
                New work and behind-the-scenes previews are shared on Instagram.
              </span>
            </p>
          </div>
        </div>
      </section>

      <section class="services" aria-labelledby="services-title">
        <div>
          <p class="eyebrow">
            <span data-i18n="servicesEyebrow">Areas of focus</span>
          </p>
          <h2 id="services-title">
            <span data-i18n="servicesTitle">Photography categories</span>
          </h2>
        </div>
        <ul>
          {
            categories.map(([en, sk]) => (
              <li>
                <span data-en={en} data-sk={sk}>{en}</span>
              </li>
            ))
          }
        </ul>
        <p class="note">
          <span data-i18n="note">
            Love Story and Wedding galleries will be added as new work becomes
            available.
          </span>
        </p>
      </section>
    </main>
    <script>
      const copy = {
        en: {
          eyebrow: "Photography in Poprad, Slovakia",
          intro:
            "Portrait, family, brand, and fine art photography from Poprad. The full portfolio is coming soon; for now, follow Elena's latest work on Instagram.",
          instagramButton: "View Instagram",
          photoCaption: "New work and behind-the-scenes previews are shared on Instagram.",
          servicesEyebrow: "Areas of focus",
          servicesTitle: "Photography categories",
          note: "Love Story and Wedding galleries will be added as new work becomes available.",
        },
        sk: {
          eyebrow: "Fotografka v Poprade, Slovensko",
          intro:
            "Portrétne, rodinné, brandové a fine art fotenie z Popradu. Kompletné portfólio pripravujeme; zatiaľ sledujte Eleninu najnovšiu tvorbu na Instagrame.",
          instagramButton: "Zobraziť Instagram",
          photoCaption: "Novú tvorbu a zákulisné momenty nájdete na Instagrame.",
          servicesEyebrow: "Zameranie",
          servicesTitle: "Kategórie fotenia",
          note: "Galérie Love Story a svadobného fotenia pribudnú, keď bude dostupná nová tvorba.",
        },
      };

      const setLanguage = (language) => {
        document.documentElement.lang = language === "sk" ? "sk" : "en";
        document.querySelectorAll("[data-i18n]").forEach((element) => {
          const key = element.getAttribute("data-i18n");
          element.textContent = copy[language][key];
        });
        document.querySelectorAll("[data-en][data-sk]").forEach((element) => {
          element.textContent = element.getAttribute(`data-${language}`);
        });
        document.querySelectorAll("[data-language-button]").forEach((button) => {
          button.classList.toggle(
            "active",
            button.getAttribute("data-language-button") === language,
          );
        });
      };

      document.querySelectorAll("[data-language-button]").forEach((button) => {
        button.addEventListener("click", () => {
          setLanguage(button.getAttribute("data-language-button"));
        });
      });
    </script>
  </body>
</html>
